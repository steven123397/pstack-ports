# Shell scripts and Node entrypoints must keep LF: Windows checkouts are read
# from WSL via /mnt/, where a CRLF interpreter line breaks bash outright.
*.sh   text eol=lf
*.bash text eol=lf
*.mjs  text eol=lf
*.ts   text eol=lf
# Extensionless launch scripts have no suffix rule; cover the scripts trees too.
pstack-*/skills/*/scripts/** text eol=lf
